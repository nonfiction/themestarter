{
  "version": 2,
  "project": {
    "slug": "themestarter",
    "password_version": 0
  },
  "wordpress": {
    "themes": [
      {
        "package": {
          "output": "dist/themestarter-v{version}.zip"
        },
        "path": "theme",
        "slug": "themestarter",
        "source": "repo",
        "tasks": {
          "build": {
            "description": "Build the theme assets",
            "run": "npm --prefix theme run build"
          },
          "check": {
            "description": "Run PHP, CSS, and JavaScript checks",
            "run": "composer --working-dir=theme check:php-style && npm --prefix theme run lint && composer --working-dir=theme test"
          },
          "composer": {
            "description": "Update theme Composer dependencies",
            "run": "composer --working-dir=theme update && composer --working-dir=theme dump-autoload -o"
          },
          "npm": {
            "description": "Refresh theme development dependencies",
            "run": "npm --prefix theme update --save-dev"
          },
          "seed": {
            "description": "Seed starter WordPress content",
            "run": "scripts/seed-starter-content"
          },
          "update": {
            "description": "Update theme Composer and npm dependencies",
            "run": "nf theme composer && nf theme npm"
          },
          "watch": {
            "description": "Watch theme assets during development",
            "run": "npm --prefix theme start"
          }
        }
      },
      "twentytwentyfive",
      "twentytwentyfour",
      "twentytwentythree"
    ],
    "plugins": [
      {
        "slug": "agency-credit",
        "source": "repo"
      },
      "imsanity",
      "insert-headers-and-footers",
      "query-monitor",
      "stream",
      "wp-crontrol",
      "wp-test-email"
    ],
    "defines": [
      {
        "name": "AGENCY_NAME",
        "value": "nonfiction studios"
      },
      {
        "name": "MY_SECRET",
        "secret": "wpdef_1ae7afe76c1be3c5153345d7349794d3"
      }
    ]
  },
  "remotes": {
    "linode": "themestarter.linode1:live"
  }
}
