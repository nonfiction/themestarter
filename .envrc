watch_file flake.nix
watch_file flake.lock
watch_file .env.age
watch_file secrets.nix
use flake

if [[ -f .env.age ]]; then
  if nf_age_identity="$(nf password age-identity)"; then
    if mkdir -p .direnv && nf_env_tmp="$(mktemp .direnv/.env.XXXXXX)"; then
      if chmod 600 "$nf_env_tmp" && agenix -d .env.age -i "$nf_age_identity" >"$nf_env_tmp"; then
        if [[ ! -f .env || -L .env ]] || ! cmp -s "$nf_env_tmp" .env; then
          if ! mv "$nf_env_tmp" .env; then
            rm -f "$nf_env_tmp"
            echo "warning: could not replace .env with decrypted .env.age; continuing" >&2
          fi
        else
          rm -f "$nf_env_tmp"
        fi
        if [[ -f .env && ! -L .env ]] && ! chmod 600 .env; then
          echo "warning: could not secure decrypted .env; continuing" >&2
        fi
      else
        rm -f "$nf_env_tmp"
        echo "warning: could not decrypt .env.age; preserving any existing .env" >&2
      fi
    else
      echo "warning: could not create a temporary file for .env.age; preserving any existing .env" >&2
    fi
  else
    echo "warning: could not prepare the nf age identity; preserving any existing .env" >&2
  fi
fi
unset nf_age_identity nf_env_tmp

dotenv_if_exists .env
